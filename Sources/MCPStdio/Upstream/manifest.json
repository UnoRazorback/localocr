  "adaptations": [
    {
      "path": "Base/ID.swift",
      "reason": "Keeps JSON-RPC scalar encoding while representing a null request ID explicitly and naming the integer case int for LocalOCR's typed contract."
    },
    {
      "path": "Base/Value.swift",
      "reason": "Retains only the JSON Value wire cases, Codable behavior, literal construction, accessors, and local data URL handling needed by LocalOCR tool schemas and results."
    },
    {
      "path": "Base/Error.swift",
      "reason": "Retains JSON-RPC standard and server errors while removing URL elicitation, transport errors, and the System dependency because the stdio type boundary has no network or client surface."
    },
    {
      "path": "Base/Messages.swift",
      "reason": "Retains public JSON-RPC request, response, and notification encoding while removing type-erased dispatch boxes that belong to the later server lifecycle implementation."
    },
    {
      "path": "Base/Lifecycle.swift",
      "reason": "Uses data-only nested lifecycle capability and implementation records instead of importing upstream Client and Server actors or their HTTP context."
    },
    {
      "path": "Base/Versioning.swift",
      "reason": "Limits the supported protocol set to the LocalOCR stdio compatibility versions and exposes deterministic negotiation without unrelated SDK version expansion."
    },
    {
      "path": "Base/Ping.swift",
      "reason": "Relocates the unchanged ping method into the audited Base directory used by the local module."
    },
    {
      "path": "Base/Cancellation.swift",
      "reason": "Relocates the cancellation notification into the audited Base directory and retains only its request ID and reason wire fields."
    },
    {
      "path": "Server/Tools.swift",
      "reason": "Retains LocalOCR's tool definitions, annotations, schemas, text content, list, and call messages while removing icons, resources, media, and resource-link content types."
    }
  ]
